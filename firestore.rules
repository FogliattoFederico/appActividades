rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla de aislamiento total por usuario para la app Mi Agendita:
    // Un usuario autenticado únicamente puede leer y modificar sus propios documentos y subcolecciones
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}