<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ActividadesDeIara" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color palette -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondaryContainer">@color/purple_500</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:timePickerDialogTheme">@style/DialogTheme.ActividadesDeIara</item>
        <item name="android:datePickerDialogTheme">@style/DialogTheme.ActividadesDeIara</item>

        <!-- High contrast TextInputLayout defaults -->
        <item name="textInputStyle">@style/Widget.ActividadesDeIara.TextInputLayout</item>
    </style>

    <style name="DialogTheme.ActividadesDeIara" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorAccent">@color/purple_500</item>
        <item name="colorSecondary">@color/purple_500</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ActividadesDeIara.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ActividadesDeIara.DialogButton</item>
    </style>

    <style name="Widget.ActividadesDeIara.DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/purple_700</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ActividadesDeIara.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/purple_700</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="Theme.ActividadesDeIara" parent="Base.Theme.ActividadesDeIara" />
</resources>