<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootViewActividad"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Actividad"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Título de la actividad -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Título de la Actividad *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Profesional Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProfesional"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Profesional / Responsable *"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actvProfesional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rubro -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRubro"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Rubro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRubro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Especialidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEspecialidad"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Especialidad">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Switch Atención a Domicilio -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAtencionDomicilioActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🏡 Atención a Domicilio"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:enabled="false" />

        <!-- Dirección de Atención -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDireccionAtencionActividad"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dirección / Lugar de atención">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDireccionAtencionActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFecha"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Fecha *"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconTint="@color/purple_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Time Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHora"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Hora (ej: 15:30) *"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_time"
            app:endIconTint="@color/purple_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Repetición Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRepeticionActividad"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Frecuencia de repetición"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actvRepeticionActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Duración de Repetición (Si es semanal) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDuracionRepeticionActividad"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="¿Durante cuánto tiempo se repite?"
            android:visibility="gone"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/actvDuracionRepeticionActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description / Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notas / Descripción (opcional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:minLines="3"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Switch Recordatorio -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRecordatorioActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔔 Activar recordatorio / notificación"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Container for Recordatorio Settings -->
        <LinearLayout
            android:id="@+id/llOpcionesRecordatorioActividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Cantidad de Notificaciones Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCantidadRecordatoriosActividad"
                style="@style/Widget.ActividadesDeIara.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="¿Cuántas notificaciones enviar?"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actvCantidadRecordatoriosActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Primer Recordatorio Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnticipacionRecordatorioActividad1"
                style="@style/Widget.ActividadesDeIara.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Primer aviso / Notificación"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actvAnticipacionRecordatorioActividad1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Segundo Recordatorio Dropdown (Visible si eligió 2) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnticipacionRecordatorioActividad2"
                style="@style/Widget.ActividadesDeIara.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Segundo aviso (opcional)"
                android:visibility="gone"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actvAnticipacionRecordatorioActividad2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvAvisoRecordatorioActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Se enviará una notificación a la fecha y hora indicadas."
                android:textColor="@color/purple_700"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:paddingVertical="14dp"
            android:text="Guardar Actividad"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="12dp"
            android:text="Eliminar Actividad"
            android:textColor="@color/cat_medico"
            android:textSize="16sp"
            android:visibility="gone"
            app:strokeColor="@color/cat_medico"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>
