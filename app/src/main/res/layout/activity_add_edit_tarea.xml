<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/tvFormTitleTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Tarea"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Task Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nombre de la Tarea (ej: Retirar pedido)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description / Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descripción / Notas (opcional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:minLines="3"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaTarea"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Fecha"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconTint="@color/purple_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Time Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHorarioTarea"
            style="@style/Widget.ActividadesDeIara.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Horario (ej: 15:30)"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_time"
            app:endIconTint="@color/purple_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHorarioTarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:paddingVertical="14dp"
            android:text="Guardar Tarea"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarTarea"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:paddingVertical="12dp"
            android:text="Eliminar Tarea"
            android:textColor="@color/cat_medico"
            android:textSize="16sp"
            android:visibility="gone"
            app:strokeColor="@color/cat_medico"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>
